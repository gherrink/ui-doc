    "coverage/**",
    "perf/**",
    "tmp/**",
    "_tmp/**",
    "cache/**",
    ".claude/**",
    "LICENSE.md",
    "TODO.md",
    "TODOs.md",
    "TODOs_*.md"
  ]
}
