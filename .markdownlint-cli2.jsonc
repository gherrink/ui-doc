{
  // `gitignore` covers node_modules, dist, .worktree and TODOs*.md.
  // Only paths that are tracked-but-unlinted, or untracked-and-not-ignored,
  // need listing below.
  "gitignore": true,
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD033": false,
    "MD034": false,
    "MD036": false
  },
  "ignores": [
    "**/coverage/**",
    ".claude/**",
    "LICENSE.md"
  ]
}
