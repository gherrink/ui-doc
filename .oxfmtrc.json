{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "pnpm-lock.yaml",
    "**/CHANGELOG.md",
    "**/*.css",
    "**/*.html",
    "**/.claude/worktrees/**"
  ]
}
