{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "jsdoc", "promise", "node", "vitest"],
  "jsPlugins": [
    "eslint-plugin-regexp",
    {
      "name": "jsdoc-js",
      "specifier": "eslint-plugin-jsdoc"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/.claude/worktrees/**"
  ],
  "rules": {
    "curly": ["error", "all"],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowNumber": true
      }
    ],
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableBoolean": true,
        "allowNullableObject": true
      }
    ],
    "typescript/ban-ts-comment": [
      "error",
      {
        "minimumDescriptionLength": 10,
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true
      }
    ],
    "typescript/explicit-function-return-type": [
      "error",
      {
        "allowExpressions": true
      }
    ],
    "typescript/method-signature-style": ["error", "property"],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": [
      "error",
      {
        "ignoreStatic": true
      }
    ],
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreIIFE": true,
        "ignoreVoid": true
      }
    ],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksConditionals": true
      }
    ],
    "regexp/no-super-linear-backtracking": "error",
    "regexp/no-unused-capturing-group": "error",
    "unicorn/error-message": "error",
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "vars": "all",
        "varsIgnorePattern": "^_"
      }
    ],
    "jsdoc/check-tag-names": "off",
    "jsdoc/require-returns-description": "error",
    "jsdoc-js/check-param-names": "error",

    // --- Rules reached by the categories above that we deliberately leave off. ---
    // Each is off because adopting it would make the code worse, not because the
    // findings were tedious. Everything else in those categories is enforced.

    // 333 findings, ~300 of them in test mocks. A narrowing `as` is the normal
    // tool at this codebase's type boundaries: Rollup's hook unions, `unknown`
    // template context, lexer token narrowing. There is no mechanical fix that
    // is not a cast by another name. The `no-unsafe-*` family and
    // `no-explicit-any` above already stop `any` leaking, which is the part
    // that actually bites.
    "typescript/no-unsafe-type-assertion": "off",

    // All four occurrences are ordered fallbacks that return on the first hit
    // (resolve a package from the consumer's paths first, then ours) or a fixed
    // three-element loop. `Promise.all` would lose the short-circuit or the
    // deterministic order.
    "eslint/no-await-in-loop": "off",

    // The only occurrence is `plugin.onLog`, which implements Rollup's
    // contract: return `false` to suppress a log, return nothing to pass it
    // through. A trailing `return undefined` would be noise.
    "typescript/consistent-return": "off",

    // The only occurrence is a deliberately side-effecting `.then()` in the
    // Vite dev-server middleware, whose chain ends in `.finally(() => next())`.
    "promise/always-return": "off",

    // The only occurrence is `TemplateLoader`, part of the published
    // `@ui-doc/html-renderer` API. Turning it into loose functions would break
    // consumers to satisfy a style preference.
    "typescript/no-extraneous-class": "off",

    // The only occurrence is `queryParentSelector<E extends Element>`, which
    // mirrors the DOM's own `querySelector<E>()` so callers can name the
    // element type they expect instead of casting at every call site.
    "typescript/no-unnecessary-type-parameters": "off",

    // The only occurrence is `import '@shared/css/index.css'` in the Vite demo.
    // Side-effect imports are how bundlers pick up stylesheets, and the rule
    // has no allow-list to exempt them.
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": [
        "*.cjs",
        "*.js",
        "*.mjs",
        ".*.cjs",
        ".*.js",
        ".*.mjs",
        ".claude/**/*.{js,mjs,cjs}",
        "**/*.config.cjs",
        "**/*.config.js",
        "**/*.config.mjs",
        "demos/**/*.{js,mjs,cjs,ts}",
        "shared/**/*.mjs"
      ],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/explicit-function-return-type": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/switch-exhaustiveness-check": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",

        // A helper defined inside the `describe` that uses it stays next to the
        // tests it serves. Hoisting it to module scope to save one closure
        // allocation per call trades locality for nothing measurable.
        "unicorn/consistent-function-scoping": "off",

        // oxlint resolves test files without a project -- the package
        // tsconfigs include only `src/**/*`, and the declaration build needs
        // `rootDir: src`, so they cannot simply be widened. Without a project
        // the type-aware pass has no ES2023 lib and reports `toSorted` as an
        // error type, so the rule's own fix does not typecheck here. Every
        // flagged call sorts a freshly built array anyway.
        "unicorn/no-array-sort": "off"
      }
    }
  ]
}
