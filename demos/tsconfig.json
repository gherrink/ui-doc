{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Demos include browser-side scripts, so DOM is needed on top of the base.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true
  },
  "include": ["**/*.ts", "**/*.mjs", "**/*.js"],
  "exclude": ["dist", "node_modules"]
}
