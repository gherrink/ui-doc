{
  "name": "ui-doc",
  "private": true,
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "fix:css": "stylelint 'packages/**/*.css' 'demos/**/*.css' --cache --fix",
    "fix:js": "eslint --cache --fix",
    "fix:md": "markdownlint-cli2 --fix '**/*.md'",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:md",
    "lint:css": "stylelint 'packages/**/*.css' 'demos/**/*.css' --cache",
    "lint:js": "eslint --cache",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "package:release": "versioner --stripShortName='^@.+/' --target",
    "package:release-dry": "versioner --dry --stripShortName='^@.+/' --target",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "release": "pnpm lint && pnpm --filter './packages/*' test && pnpm --filter './packages/*' --workspace-concurrency=1 release",
    "release:dry": "pnpm lint && pnpm --filter './packages/*' test && pnpm --filter './packages/*' --workspace-concurrency=1 release:dry",
    "security": "pnpm audit --audit-level=high",
    "workspace:build": "pnpm -r --filter='./packages/*' run build",
    "workspace:test": "pnpm --filter='./packages/*' run test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@babel/core": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@dot/versioner": "^0.3.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.14.0",
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.1",
    "eslint": "^9.19.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "markdownlint-cli2": "^0.17.2",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^6.0.1",
    "rollup": "^4.18.0",
    "rollup-plugin-postcss": "^4.0.2",
    "stylelint": "^16.6.1",
    "stylelint-config-clean-order": "^6.0.0",
    "stylelint-config-standard": "^36.0.0",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vitest": "^3.0.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --cache --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ],
    "*.{json,jsonc}": [
      "eslint --cache --fix"
    ],
    "*.{yml,yaml}": [
      "eslint --cache --fix"
    ],
    "*.md": [
      "eslint --cache --fix",
      "markdownlint-cli2 --fix"
    ]
  }
}
