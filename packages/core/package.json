{
  "name": "@ui-doc/core",
  "version": "0.5.1",
  "description": "Core to generate a ui documentation out of comments.",
  "keywords": [
    "documentation",
    "generation",
    "styleguide",
    "ui-doc",
    "ui-kit"
  ],
  "homepage": "https://github.com/gherrink/ui-doc/tree/master/packages/core#readme",
  "bugs": "https://github.com/gherrink/ui-doc/issues",
  "license": "MIT",
  "author": "Maurice Busch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gherrink/ui-doc.git",
    "directory": "packages/core"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --rootDir src --declarationDir dist && rollup -c",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "release": "pnpm --workspace-root package:release $(pwd)",
    "release:dry": "pnpm --workspace-root package:release-dry $(pwd)",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "comment-parser": "^1.4.1",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
