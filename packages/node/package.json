{
  "name": "@ui-doc/node",
  "version": "0.3.0",
  "description": "Node implementations for UI-Doc.",
  "author": "Maurice Busch",
  "license": "MIT",
  "homepage": "https://github.com/gherrink/ui-doc/tree/master/packages/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gherrink/ui-doc.git",
    "directory": "packages/node"
  },
  "bugs": "https://github.com/gherrink/ui-doc/issues",
  "keywords": [
    "ui-doc",
    "styleguide",
    "ui-kit",
    "documentation",
    "generation",
    "node"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean",
    "prepare": "if [ ! -d 'dist' ]; then pnpm build; fi",
    "prepublish": "pnpm build",
    "release": "pnpm --workspace-root package:release $(pwd)",
    "release:dry": "pnpm --workspace-root package:release-dry $(pwd)",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@ui-doc/core": "workspace:>=0.3.0"
  },
  "dependencies": {
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/picomatch": "^2.3.3",
    "@ui-doc/core": "workspace:^"
  }
}
