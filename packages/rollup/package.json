{
  "name": "@ui-doc/rollup",
  "version": "0.6.1",
  "description": "Rollup plugin for UI-Doc generation.",
  "author": "Maurice Busch",
  "license": "MIT",
  "homepage": "https://github.com/gherrink/ui-doc/tree/master/packages/rollup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gherrink/ui-doc.git",
    "directory": "packages/rollup"
  },
  "bugs": "https://github.com/gherrink/ui-doc/issues",
  "keywords": [
    "ui-doc",
    "styleguide",
    "ui-kit",
    "documentation",
    "generation",
    "rollup",
    "rollup-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm clean && rollup -c",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "release": "pnpm --workspace-root package:release $(pwd)",
    "release:dry": "pnpm --workspace-root package:release-dry $(pwd)",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@ui-doc/html-renderer": "workspace:^",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "@ui-doc/core": "workspace:^",
    "@ui-doc/node": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@ui-doc/html-renderer": "workspace:^",
    "picomatch": "^4.0.2",
    "rollup": "catalog:",
    "vitest": "catalog:"
  }
}
