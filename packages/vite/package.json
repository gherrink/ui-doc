{
  "name": "@ui-doc/vite",
  "version": "0.7.0",
  "description": "Vite plugin for UI-Doc generation and preview.",
  "keywords": [
    "documentation",
    "generation",
    "styleguide",
    "ui-doc",
    "ui-kit",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/gherrink/ui-doc/tree/master/packages/vite#readme",
  "bugs": "https://github.com/gherrink/ui-doc/issues",
  "license": "MIT",
  "author": "Maurice Busch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gherrink/ui-doc.git",
    "directory": "packages/vite"
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --rootDir src --declarationDir dist && rollup -c",
    "clean": "rm -rf dist",
    "prepack": "pnpm build",
    "release": "pnpm --workspace-root package:release $(pwd)",
    "release:dry": "pnpm --workspace-root package:release-dry $(pwd)",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ui-doc/rollup": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "picocolors": "^1.0.1",
    "rollup": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
