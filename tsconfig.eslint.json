{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/*.ts",
    "packages/*/*.mjs",
    "demos/**/*.ts",
    "shared/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
